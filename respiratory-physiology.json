{"id":"respiratory-physiology","system":"Respiratory","subject":"Physiology","pages":[682,689],"rounds":[{"t":"Lung volumes, work of breathing and dead space","q":[{"s":"What is the typical tidal volume in a healthy adult?","o":["About 1200 mL","About 3000 mL","About 150 mL","About 6000 mL","About 500 mL (6–8 mL/kg)"],"e":["Wrong. Residual volume.","Wrong. Not correct.","Wrong. Dead space.","Wrong. TLC.","Correct."],"a":4,"p":"682","k":"Lung volumes and capacities"},{"s":"Which volume is the air still in the lungs after maximal expiration?","o":["Inspiratory reserve volume","Vital capacity","Residual volume","Expiratory reserve volume","Tidal volume"],"e":["Wrong. Not correct.","Wrong. Not correct.","Correct.","Wrong. Not correct.","Wrong. Not correct."],"a":2,"p":"682","k":"Lung volumes and capacities"},{"s":"Which cannot be measured by spirometry?","o":["Tidal volume","Functional residual capacity","Expiratory reserve volume","Vital capacity","Inspiratory capacity"],"e":["Wrong. Measurable.","Correct. Contains RV.","Wrong. Measurable.","Wrong. Measurable.","Wrong. Measurable."],"a":1,"p":"682","k":"Lung volumes and capacities"},{"s":"Functional residual capacity equals which?","o":["VC + RV","IRV + VT + ERV","IRV + VT","RV + ERV","VT + ERV"],"e":["Wrong. TLC.","Wrong. Vital capacity.","Wrong. Inspiratory capacity.","Correct.","Wrong. Not correct."],"a":3,"p":"682","k":"Lung volumes and capacities"},{"s":"At functional residual capacity, which forces are balanced?","o":["Outward pull of the chest wall and inward collapse of the lungs","Inspiratory and expiratory muscles","Surfactant and surface tension","Diaphragm contraction and abdominal pressure","Airway resistance and elastic recoil"],"e":["Correct.","Wrong. Muscles relaxed.","Wrong. Not correct.","Wrong. Not correct.","Wrong. Not correct."],"a":0,"p":"682","k":"Lung volumes and capacities"},{"s":"Vital capacity equals which?","o":["IRV + VT + ERV","TLC + RV","VT + RV","RV + ERV","IRV + VT"],"e":["Correct.","Wr